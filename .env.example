# ---------------------------------------------------------------------------
# HADER AI | حاضر  —  environment template. Never commit real credentials.
# ---------------------------------------------------------------------------

# Public app origin. Used for PWA + pairing links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (optional in Local/Demo mode, REQUIRED for cross-device sync) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zero-subscription default: no paid provider calls unless explicitly enabled.
HADER_PAID_PROVIDERS=0
# Local installation only. Runs llama.cpp on 127.0.0.1:8080, never a hosted user localhost.
HADER_LOCAL_AI=0

# --- Qwen / Alibaba Model Studio (server-side only, never NEXT_PUBLIC) ---
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
# singapore | beijing
QWEN_REGION=singapore
# No stale model defaults. Choose currently available compatible models from your provider/region.
QWEN_ASR_MODEL=
QWEN_TEXT_MODEL=

# --- Web Push (optional; required for background phone alerts) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
